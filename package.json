{
  "name": "ba-space",
  "version": "1.0.8",
  "description": "Business Analyst workspace manager with Git worktrees, screen inspection, and AI agent harnesses",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --outfile=dist/main/main.js --platform=node --format=cjs --bundle --external:electron --external:node-pty",
    "build:preload": "esbuild src/main/preload.ts --outfile=dist/main/preload.js --platform=node --format=cjs --bundle --external:electron",
    "build:renderer": "esbuild src/renderer/app.ts --bundle --outfile=dist/renderer/app.bundle.js --platform=browser --format=iife --target=chrome120",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "test": "node --test src/domain/**/*.test.js",
    "start": "npm run build && electron .",
    "fetch-runtimes": "node scripts/fetch-runtimes.mjs",
    "sync-obsidian-config": "node scripts/sync-obsidian-config.mjs",
    "pack": "npm run build && npm run fetch-runtimes && electron-builder --dir",
    "make": "npm run build && npm run fetch-runtimes && electron-builder",
    "make:win": "npm run build && npm run fetch-runtimes -- win-x64 && electron-builder --win",
    "make:mac": "npm run build && npm run fetch-runtimes -- mac-arm64 mac-x64 && electron-builder --mac",
    "make:linux": "npm run build && npm run fetch-runtimes -- linux-x64 && electron-builder --linux"
  },
  "keywords": [
    "business-analyst",
    "worktree",
    "workspace",
    "terminal",
    "scrcpy",
    "specifications"
  ],
  "author": {
    "name": "impeterwayne"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^25.6.2",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.baspace.app",
    "productName": "BA Space",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "toolkits",
        "to": "toolkits"
      },
      {
        "from": "resources/obsidian-config",
        "to": "obsidian-config"
      },
      {
        "from": "runtimes/${os}-${arch}",
        "to": "runtimes",
        "filter": [
          "**/*",
          "!.fetched"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BA Space",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "synopsis": "Business Analyst workspace manager"
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "impeterwayne",
        "repo": "BAS_Business_Analysis_Space",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/impeterwayne/BAS_Business_Analysis_Space.git"
  }
}
